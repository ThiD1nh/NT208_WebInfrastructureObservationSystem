// Day du lieu toi cac database

prometheus.remote_write "demo_prom" {
    endpoint = {
        url = "http://promethus:9090/api/v1/write"
    }
}

loki.write "demo_loki" {
    endpoint = {
        url = "http://loki:3100/loki/api/v1/push"
    }
}

otelcol.exporter.otlp "demo_tempo" {
    client {
        endpoint = "tempo:4317"
        tls {
            insecure = true,
            insecure_skip_verify = true
        }
    }
}

// Thu thap logs

local.file_match "app_logs" {
    path_targets = [
        {__path__ = "/var/log/app/*.log", service = "backend-app"},
        {__path__ = "/var/log/nginx/*.log", service = "nginx-proxy"},
    ]
}

loki.source.file "log_reader" {
    targets = local.file_match.app_logs.targets
    forward_to = [loki.write.demo_loki.receiver]
}

// Thu thap traces

otelcol.receiver.otlp "trace_receiver" {
    grpc {
        endpoint = "0.0.0.0:4317"
    }

    output {
        traces = [otelcol.exporter.otlp.demo_tempo.input]
    }
}



// Tich hop exporters

prometheus.exporters.nginx "demo_nginx" {
    scrape_uri = "http://nginx:8080/stub_status"
}

prometheus.exporters.mysql "demo_mysql" {
    data_source_name = "app_user:app_password@(database:3306)/"
}

prometheus.scape "internal_exporters" {
    targets = array.concat (
        prometheus.exporters.nginx.demo_nginx.targets,
        prometheus.exporters.mysql.demo_mysql.targets,
    )
    forward_to = [prometheus.remote_write.demo_prom.receiver]
}

