// Ouput destination

prometheus.remote_write "to_prometheus" {
    endpoint {
        url = "http://demo_prometheus:9090/api/v1/write"
    }
}

loki.write "to_loki" {
    endpoint {
        url = "http://demo_loki:3100/loki/api/v1/push"
    }
}

otelcol.exporter.otlp "to_tempo" {
    client {
        endpoint = "demo_tempo:4317"
        
        tls {
            insecure = true 
            insecure_skip_verify = true 
        }
    }
}

// Metrics collection

prometheus.exporter.mysql "db_metrics" {
    data_source_name = "app_user:app_password@(demo_mysql:3306)/"
}

prometheus.scrape "scrap_all_metrics" {
    scrape_interval = "15s"
    scrape_timeout = "10s"
    targets = array.concat (
        prometheus.exporter.mysql.db_metrics.targets,
        [
            { "__address__" = "demo_nginx_exporter:9113", job = "nginx-proxy"},
            { "__address__" = "demo_backend:8000", job = "fastapi-backend"},
        ],
    )
    forward_to = [prometheus.remote_write.to_prometheus.receiver]
}

// Log collection

local.file_match "discover_logs" {
    path_targets = [
        {
            "__path__" = "/var/log/app/*.log",
            "job" = "fastapi-backend",
            "type" = "application",
        },
        {
            "__path__" = "/var/log/nginx/*.log",
            "job" = "nginx-proxy", 
            "type" = "infrastructure",
        },
    ]
}


loki.source.file "read_logs" {
    targets = local.file_match.discover_logs.targets
    forward_to = [loki.write.to_loki.receiver]
}

// Traces collection

otelcol.receiver.otlp "receive_traces" {
    grpc {
        endpoint = "0.0.0.0:4317"
    }
    http {
        endpoint = "0.0.0.0:4318"
    }
    output {
        traces = [otelcol.exporter.otlp.to_tempo.input]
    }
}